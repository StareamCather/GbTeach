<sdf version="1.9">
  <world name="default">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <gui>
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>.47 .47 .47</ambient_light>
        <background_color>.16 .21 .28</background_color>
        <camera_pose>-2.8 -4.8 3 0 .44 1.0</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control" />
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property key="state" type="string">docked</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">64</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/default/control</service>
        <stats_topic>/world/default/stats</stats_topic>
      </plugin>
    </gui>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.12 0.15 0.2 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.4 0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="body">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>30 30 .2</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>30 30 .2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.35 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -.1 0 0 0</pose>
    </model>
    <model name="tf_rig" canonical_link="base">
      <pose>-.65 -.55 .65 0 0 0</pose>
      <link name="base">
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>.018</ixx>
            <iyy>.032</iyy>
            <izz>.04</izz>
          </inertia>
        </inertial>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>.80 .48 .18</size>
            </box>
          </geometry>
          <material>
            <ambient>.08 .36 .80 1</ambient>
            <diffuse>.12 .48 .96 1</diffuse>
          </material>
        </visual>
        <visual name="sensor_mount">
          <pose>.45 .20 .15 0 0 -.35</pose>
          <geometry>
            <box>
              <size>.21 .12 .13</size>
            </box>
          </geometry>
          <material>
            <ambient>.93 .40 .04 1</ambient>
            <diffuse>1 .55 .08 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_frame>world</odom_frame>
        <robot_base_frame>m24_rig</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
        <tf_topic>/gt/m24/rig_pose</tf_topic>
      </plugin>
    </model>
  </world>
</sdf>
