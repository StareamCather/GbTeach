{
  "id": "22",
  "title": "ROS 2节点、话题与QoS兼容性",
  "module": "现代Gazebo与ROS 2",
  "order": 22,
  "profile": "harmonic-jazzy",
  "requires_ros": true,
  "requires_ros_packages": [
    "rclpy",
    "std_msgs",
    "ros_gz_bridge",
    "rosgraph_msgs"
  ],
  "world": "world.sdf",
  "verify": "verify.py",
  "reference": "reference.md",
  "verify_timeout": 100,
  "objectives": [
    "用实时 DDS 图发现两个订阅者，并观测可靠性不兼容事件",
    "比较晚加入时 TRANSIENT_LOCAL 与 VOLATILE 的实际交付序号",
    "让执行器暂停取样，验证 KEEP_LAST 深度 3 与 16 的实际接收差异",
    "用 Gazebo Transport 的原生仿真时间交叉核对 ROS 2 时钟"
  ],
  "commands": [
    {
      "title": "运行可靠性、持久性、历史队列与时钟对照",
      "command": "python3 lab.py"
    },
    {
      "title": "重新验收",
      "command": "python3 verify.py"
    },
    {
      "title": "查看 ROS 2 仿真时钟",
      "command": "ros2 topic echo /clock --once --no-daemon"
    }
  ],
  "startup": [
    {
      "name": "仿真时钟桥",
      "command": "ros2 run ros_gz_bridge parameter_bridge \"/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock\""
    }
  ],
  "variants": {
    "fortress-humble": {
      "world": "world.fortress.sdf",
      "startup": [
        {
          "name": "仿真时钟桥",
          "command": "ros2 run ros_gz_bridge parameter_bridge \"/clock@rosgraph_msgs/msg/Clock[ignition.msgs.Clock\""
        }
      ]
    }
  }
}
