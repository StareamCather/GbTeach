<sdf version="1.9">
  <world name="default">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <gui>
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>.47 .47 .47</ambient_light>
        <background_color>.16 .21 .28</background_color>
        <camera_pose>-4.7 -6.0 4.0 0 .43 .75</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control" />
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property key="state" type="string">docked</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">64</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/default/control</service>
        <stats_topic>/world/default/stats</stats_topic>
      </plugin>
    </gui>
    <scene>
      <ambient>.45 .45 .45 1</ambient>
      <background>0.12 0.15 0.2 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.4 0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="body">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>30 30 .2</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>30 30 .2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.35 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -.1 0 0 0</pose>
    </model>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <model name="obstacle">
      <static>true</static>
      <pose>4 0 1 0 0 0</pose>
      <link name="body">
        <collision name="body_collision">
          <geometry>
            <box>
              <size>.2 6 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="body_visual">
          <geometry>
            <box>
              <size>.2 6 2</size>
            </box>
          </geometry>
          <material>
            <diffuse>.2 .7 .3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rover" canonical_link="base">
      <pose>0 0 .15 0 0 0</pose>
      <link name="base">
        <pose>0 0 .1 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>.04</ixx>
            <iyy>.04</iyy>
            <izz>.04</izz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <geometry>
            <box>
              <size>.5 .4 .15</size>
            </box>
          </geometry>
        </collision>
        <visual name="body_visual">
          <geometry>
            <box>
              <size>.5 .4 .15</size>
            </box>
          </geometry>
          <material>
            <diffuse>.1 .35 .9 1</diffuse>
          </material>
        </visual>
        <sensor name="laser" type="gpu_lidar">
          <pose>.2 0 .15 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/gt/scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>181</samples>
                <resolution>1</resolution>
                <min_angle>-1.57</min_angle>
                <max_angle>1.57</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>.08</min>
              <max>12</max>
              <resolution>.01</resolution>
            </range>
          </lidar>
          <gz_frame_id>laser</gz_frame_id>
        </sensor>
      </link>
      <link name="left">
        <pose>.12 0.26 0 1.570796 0 0</pose>
        <inertial>
          <mass>.1</mass>
          <inertia>
            <ixx>.001</ixx>
            <iyy>.001</iyy>
            <izz>.001</izz>
          </inertia>
        </inertial>
        <collision name="wheel_collision">
          <geometry>
            <cylinder>
              <radius>.15</radius>
              <length>.08</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel_visual">
          <geometry>
            <cylinder>
              <radius>.15</radius>
              <length>.08</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>.08 .08 .08 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_joint" type="revolute">
        <parent>base</parent>
        <child>left</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>
      <link name="right">
        <pose>.12 -0.26 0 1.570796 0 0</pose>
        <inertial>
          <mass>.1</mass>
          <inertia>
            <ixx>.001</ixx>
            <iyy>.001</iyy>
            <izz>.001</izz>
          </inertia>
        </inertial>
        <collision name="wheel_collision">
          <geometry>
            <cylinder>
              <radius>.15</radius>
              <length>.08</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel_visual">
          <geometry>
            <cylinder>
              <radius>.15</radius>
              <length>.08</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>.08 .08 .08 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_joint" type="revolute">
        <parent>base</parent>
        <child>right</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>
      <link name="caster">
        <pose>-.2 0 -.07 0 0 0</pose>
        <inertial>
          <mass>.05</mass>
          <inertia>
            <ixx>.0001</ixx>
            <iyy>.0001</iyy>
            <izz>.0001</izz>
          </inertia>
        </inertial>
        <collision name="sphere_collision">
          <geometry>
            <sphere>
              <radius>.08</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>.001</mu>
                <mu2>.001</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="sphere_visual">
          <geometry>
            <sphere>
              <radius>.08</radius>
            </sphere>
          </geometry>
        </visual>
      </link>
      <joint name="caster_fixed" type="fixed">
        <parent>base</parent>
        <child>caster</child>
      </joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint>
        <right_joint>right_joint</right_joint>
        <wheel_separation>.52</wheel_separation>
        <wheel_radius>.15</wheel_radius>
        <topic>/gt/cmd_vel</topic>
        <odom_topic>/gt/odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <frame_id>odom</frame_id>
        <child_frame_id>base</child_frame_id>
        <min_linear_velocity>-.50</min_linear_velocity>
        <max_linear_velocity>.50</max_linear_velocity>
        <min_angular_velocity>-1</min_angular_velocity>
        <max_angular_velocity>1</max_angular_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/gt/wheels</topic>
        <update_rate>30</update_rate>
        <joint_name>left_joint</joint_name>
        <joint_name>right_joint</joint_name>
      </plugin>
    </model>
  </world>
</sdf>
