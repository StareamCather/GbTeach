<sdf version="1.9">
  <world name="default">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <gui>
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>.47 .47 .47</ambient_light>
        <background_color>.16 .21 .28</background_color>
        <camera_pose>4.7 -7.3 4.7 0 .42 2.14</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control" />
      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property key="state" type="string">docked</property>
        </ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">64</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/default/control</service>
        <stats_topic>/world/default/stats</stats_topic>
      </plugin>
    </gui>
    <scene>
      <ambient>.47 .47 .47 1</ambient>
      <background>.16 .21 .28 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.4 0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="body">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>30 30 .2</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>30 30 .2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.35 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -.1 0 0 0</pose>
    </model>
    <model name="probe">
      <pose>0 2.65 1.5 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>.006667</ixx>
            <iyy>.006667</iyy>
            <izz>.006667</izz>
          </inertia>
        </inertial>
        <collision name="probe_collision">
          <geometry>
            <box>
              <size>.2 .2 .2</size>
            </box>
          </geometry>
        </collision>
        <visual name="probe_visual">
          <geometry>
            <box>
              <size>.2 .2 .2</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 .3 .1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="arch">
      <static>true</static>
      <pose>0 1.35 0 0 0 0</pose>
      <link name="body">
        <collision name="left_collision">
          <pose>-1.2 0 1.2 0 0 0</pose>
          <geometry>
            <box>
              <size>.4 .5 2.4</size>
            </box>
          </geometry>
        </collision>
        <collision name="right_collision">
          <pose>1.2 0 1.2 0 0 0</pose>
          <geometry>
            <box>
              <size>.4 .5 2.4</size>
            </box>
          </geometry>
        </collision>
        <collision name="beam_collision">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry>
            <box>
              <size>2.8 .5 .4</size>
            </box>
          </geometry>
        </collision>
        <visual name="left_visual">
          <pose>-1.2 0 1.2 0 0 0</pose>
          <geometry>
            <box>
              <size>.4 .5 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>1 1 1 1</specular>
            <pbr>
              <metal>
                <albedo_map>textures/albedo.png</albedo_map>
                <roughness_map>textures/roughness.png</roughness_map>
                <normal_map>textures/normal.png</normal_map>
                <metalness>.05</metalness>
                <roughness>.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <visual name="right_visual">
          <pose>1.2 0 1.2 0 0 0</pose>
          <geometry>
            <box>
              <size>.4 .5 2.4</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>1 1 1 1</specular>
            <pbr>
              <metal>
                <albedo_map>textures/albedo.png</albedo_map>
                <metalness>.8</metalness>
                <roughness>.15</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <visual name="beam_visual">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry>
            <box>
              <size>2.8 .5 .4</size>
            </box>
          </geometry>
          <material>
            <diffuse>.8 .7 .3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <light name="spot" type="spot">
      <pose>0 -2.5 4.4 0 0 0</pose>
      <diffuse>.9 .65 .35 1</diffuse>
      <specular>1 1 1 1</specular>
      <direction>0 .75 -1</direction>
      <attenuation>
        <range>15</range>
        <constant>1</constant>
        <linear>.1</linear>
        <quadratic>.02</quadratic>
      </attenuation>
      <spot>
        <inner_angle>.3</inner_angle>
        <outer_angle>.8</outer_angle>
        <falloff>1</falloff>
      </spot>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="station_a">
      <static>true</static>
      <pose>-1.9 -1.30 .60 0 0 0</pose>
      <link name="sample">
        <collision name="support_collision">
          <geometry>
            <box>
              <size>1.15 .86 .40</size>
            </box>
          </geometry>
        </collision>
        <visual name="sample_visual">
          <geometry>
            <box>
              <size>1.15 .86 .40</size>
            </box>
          </geometry>
          <material>
            <ambient>.22 .69 .71 1</ambient>
            <diffuse>.22 .69 .71 1</diffuse>
          </material>
        </visual>
        <visual name="station_marker">
          <pose>0 0 -.58 0 0 0</pose>
          <geometry>
            <box>
              <size>1.28 1.05 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>.28 .32 .36 1</ambient>
            <diffuse>.28 .32 .36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="station_b">
      <static>true</static>
      <pose>0 -1.30 .60 0 0 0</pose>
      <link name="sample">
        <collision name="support_collision">
          <geometry>
            <box>
              <size>1.15 .86 .40</size>
            </box>
          </geometry>
        </collision>
        <visual name="sample_visual">
          <geometry>
            <box>
              <size>1.15 .86 .16</size>
            </box>
          </geometry>
          <material>
            <ambient>.22 .69 .71 1</ambient>
            <diffuse>.22 .69 .71 1</diffuse>
          </material>
        </visual>
        <visual name="station_marker">
          <pose>0 0 -.58 0 0 0</pose>
          <geometry>
            <box>
              <size>1.28 1.05 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>.28 .32 .36 1</ambient>
            <diffuse>.28 .32 .36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="station_c">
      <static>true</static>
      <pose>1.9 -1.30 .60 0 0 0</pose>
      <link name="sample">
        <collision name="support_collision">
          <geometry>
            <box>
              <size>1.15 .86 .80</size>
            </box>
          </geometry>
        </collision>
        <visual name="sample_visual">
          <geometry>
            <box>
              <size>1.15 .86 .16</size>
            </box>
          </geometry>
          <material>
            <ambient>.22 .69 .71 1</ambient>
            <diffuse>.22 .69 .71 1</diffuse>
          </material>
        </visual>
        <visual name="station_marker">
          <pose>0 0 -.58 0 0 0</pose>
          <geometry>
            <box>
              <size>1.28 1.05 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>.28 .32 .36 1</ambient>
            <diffuse>.28 .32 .36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
