<sdf version="1.9">
  <world name="default">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <gui>
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>.47 .47 .47</ambient_light>
        <background_color>.16 .21 .28</background_color>
        <camera_pose>-2.1 -4.6 2.8 0 .49 1.14</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control" />
      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property key="state" type="string">docked</property>
        </ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">64</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/default/control</service>
        <stats_topic>/world/default/stats</stats_topic>
      </plugin>
    </gui>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.12 0.15 0.2 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.4 0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="body">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>30 30 .2</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>30 30 .2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.35 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -.1 0 0 0</pose>
    </model>
    <model name="rail">
      <static>true</static>
      <link name="frame">
        <visual name="rail_beam">
          <pose>0 0 .24 0 0 0</pose>
          <geometry>
            <box>
              <size>3.1 .26 .12</size>
            </box>
          </geometry>
          <material>
            <ambient>.25 .30 .36 1</ambient>
            <diffuse>.25 .30 .36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rail_carriage" canonical_link="carriage">
      <pose>0 0 .42 0 0 0</pose>
      <link name="carriage">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>.009</ixx>
            <iyy>.017</iyy>
            <izz>.021</izz>
          </inertia>
        </inertial>
        <visual name="orange_carriage">
          <geometry>
            <box>
              <size>.37 .36 .22</size>
            </box>
          </geometry>
          <material>
            <ambient>.90 .34 .08 1</ambient>
            <diffuse>.96 .38 .08 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="rail_joint" type="prismatic">
        <parent>world</parent>
        <child>carriage</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-1.35</lower>
            <upper>1.35</upper>
            <effort>25</effort>
            <velocity>.60</velocity>
          </limit>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>rail_joint</joint_name>
        <topic>/gt/rail/velocity_command</topic>
        <initial_velocity>0</initial_velocity>
      </plugin>
      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
        <joint_name>rail_joint</joint_name>
        <topic>/gt/rail/joints</topic>
        <update_rate>30</update_rate>
      </plugin>
    </model>
  </world>
</sdf>
