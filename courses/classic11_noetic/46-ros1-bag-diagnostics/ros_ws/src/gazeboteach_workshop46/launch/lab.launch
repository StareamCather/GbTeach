<launch><arg name="namespace" default="workshop46"/><group ns="$(arg namespace)"><node pkg="gazeboteach_workshop46" type="node.py" name="observer" args="observer" output="screen" required="true"><param name="emit_state" value="true" type="bool"/></node><node pkg="gazeboteach_workshop46" type="node.py" name="diagnostic_monitor" args="monitor" output="screen" required="true"><rosparam command="load" file="$(find gazeboteach_workshop46)/config/controller.yaml"/></node></group></launch>
