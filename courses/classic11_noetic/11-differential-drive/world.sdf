<?xml version="1.0"?>
<sdf version="1.7"><world name="default">
  <gravity>0 0 -9.81</gravity>
  <physics name="ode" type="ode"><max_step_size>.001</max_step_size><real_time_update_rate>1000</real_time_update_rate><ode><solver><type>quick</type><iters>100</iters><friction_model>pyramid_model</friction_model></solver></ode></physics>
  <scene><ambient>.6 .6 .6 1</ambient><background>.84 .89 .95 1</background><shadows>true</shadows></scene>
  <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>.9 .9 .9 1</diffuse><direction>-.5 .1 -1</direction></light>
  <gui><camera name="user_camera"><pose>2.4 -3.3 3.2 0 .65 2.15</pose></camera></gui>
  <model name="floor"><static>true</static><link name="ground">
    <collision name="floor_collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><surface><friction><ode><mu>.8</mu><mu2>.8</mu2></ode></friction></surface></collision>
    <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>.72 .76 .8 1</ambient><diffuse>.72 .76 .8 1</diffuse></material></visual>
    <visual name="x_reference"><pose>1 0 .001 0 0 0</pose><geometry><box><size>2 .012 .002</size></box></geometry><material><ambient>.8 .22 .16 1</ambient><diffuse>.8 .22 .16 1</diffuse></material></visual>
    <visual name="y_reference"><pose>0 1 .001 0 0 0</pose><geometry><box><size>.012 2 .002</size></box></geometry><material><ambient>.16 .65 .3 1</ambient><diffuse>.16 .65 .3 1</diffuse></material></visual>
  </link></model>
  <model name="differential_car"><static>false</static><self_collide>false</self_collide><allow_auto_disable>false</allow_auto_disable>
    <link name="chassis"><pose>0 0 .1302 0 0 0</pose>
      <inertial><pose>-.10 0 0 0 0 0</pose><mass>2</mass><inertia><ixx>.0106666666666667</ixx><iyy>.0304666666666667</iyy><izz>.039</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="chassis_collision"><pose>-.1 0 0 0 0 0</pose><geometry><box><size>.42 .24 .08</size></box></geometry></collision>
      <visual name="body"><pose>-.1 0 0 0 0 0</pose><geometry><box><size>.42 .24 .08</size></box></geometry><material><ambient>.10 .42 .75 1</ambient><diffuse>.10 .42 .75 1</diffuse></material></visual>
      <visual name="forward"><pose>.075 0 .046 0 0 0</pose><geometry><box><size>.055 .025 .012</size></box></geometry><material><ambient>1 .6 .08 1</ambient><diffuse>1 .6 .08 1</diffuse></material></visual>
    </link>
    <link name="left_wheel"><pose>0 .18 .1002 0 0 0</pose>
      <inertial><mass>.2</mass><inertia><ixx>.000501666666666667</ixx><iyy>.001</iyy><izz>.000501666666666667</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="wheel_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>.1</radius><length>.01</length></cylinder></geometry><surface><friction><ode><mu>.8</mu><mu2>.8</mu2></ode></friction></surface></collision>
      <visual name="wheel"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>.1</radius><length>.01</length></cylinder></geometry><material><ambient>.13 .15 .18 1</ambient><diffuse>.13 .15 .18 1</diffuse></material></visual>
      <visual name="spoke"><pose>0 .0075 0 0 0 0</pose><geometry><box><size>.15 .005 .012</size></box></geometry><material><ambient>1 .75 .1 1</ambient><diffuse>1 .75 .1 1</diffuse></material></visual>
    </link>
    <link name="right_wheel"><pose>0 -.18 .1002 0 0 0</pose>
      <inertial><mass>.2</mass><inertia><ixx>.000501666666666667</ixx><iyy>.001</iyy><izz>.000501666666666667</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="wheel_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>.1</radius><length>.01</length></cylinder></geometry><surface><friction><ode><mu>.8</mu><mu2>.8</mu2></ode></friction></surface></collision>
      <visual name="wheel"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>.1</radius><length>.01</length></cylinder></geometry><material><ambient>.13 .15 .18 1</ambient><diffuse>.13 .15 .18 1</diffuse></material></visual>
      <visual name="spoke"><pose>0 -.0075 0 0 0 0</pose><geometry><box><size>.15 .005 .012</size></box></geometry><material><ambient>1 .75 .1 1</ambient><diffuse>1 .75 .1 1</diffuse></material></visual>
    </link>
    <link name="caster"><pose>-.2 0 .0352 0 0 0</pose><inertial><mass>.05</mass><inertia><ixx>.0000245</ixx><iyy>.0000245</iyy><izz>.0000245</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="caster_collision"><geometry><sphere><radius>.035</radius></sphere></geometry><surface><friction><ode><mu>.001</mu><mu2>.001</mu2></ode></friction></surface></collision><visual name="support"><geometry><sphere><radius>.035</radius></sphere></geometry><material><ambient>.5 .52 .55 1</ambient><diffuse>.5 .52 .55 1</diffuse></material></visual></link>
    <joint name="left_joint" type="revolute"><parent>chassis</parent><child>left_wheel</child><pose relative_to="left_wheel">0 0 0 0 0 0</pose><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>10</effort><velocity>30</velocity></limit><dynamics><damping>0</damping><friction>0</friction></dynamics></axis></joint>
    <joint name="right_joint" type="revolute"><parent>chassis</parent><child>right_wheel</child><pose relative_to="right_wheel">0 0 0 0 0 0</pose><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>10</effort><velocity>30</velocity></limit><dynamics><damping>0</damping><friction>0</friction></dynamics></axis></joint>
    <joint name="caster_fixed" type="fixed"><parent>chassis</parent><child>caster</child></joint>
    <plugin name="native_differential_drive" filename="libDiffDrivePlugin.so"><left_joint>left_joint</left_joint><right_joint>right_joint</right_joint></plugin>
    <plugin name="bounded_differential_observer" filename="libgazeboteach_drive_lab.so"/>
  </model>
</world></sdf>
