<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <!-- 长度使用米、质量使用千克，姿态角使用弧度。平台与探针均无初始转角。 -->
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.82 0.87 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <!-- 地面碰撞平面位于 z=0；后面的两个探针都可能由它支撑。 -->
    <model name="ground">
      <static>true</static>
      <link name="surface">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.68 0.72 1</ambient>
            <diffuse>0.65 0.68 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 静态墙体只作为房间背景，不参与本课落点比较。 -->
    <model name="back_wall">
      <static>true</static>
      <pose>0 2 1 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.33520833333333333</ixx>
            <iyy>2.4166666666666665</iyy>
            <izz>2.0852083333333336</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>5 0.15 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5 0.15 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.45 0.9 1</ambient>
            <diffuse>0.1 0.45 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- model → link → collision/visual：同一个刚体有两种用途的几何描述。 -->
    <model name="left_wall">
      <static>true</static>
      <pose>-2.5 0 1 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>1.6666666666666667</ixx>
            <iyy>0.33520833333333333</iyy>
            <izz>1.3352083333333333</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 4 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 4 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.45 0.9 1</ambient>
            <diffuse>0.1 0.45 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 左平台：外观和右平台相同，但此 link 同时具有 collision。 -->
    <model name="solid_platform">
      <static>true</static>
      <pose>-1 0 1 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.08666666666666667</ixx>
            <iyy>0.08666666666666667</iyy>
            <izz>0.16666666666666666</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.65 0.55 1</ambient>
            <diffuse>0.15 0.65 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 右平台：故意只有 visual，没有 collision；这是一种有效配置，不是 XML 错误。 -->
    <model name="ghost_platform">
      <static>true</static>
      <pose>1 0 1 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.08666666666666667</ixx>
            <iyy>0.08666666666666667</iyy>
            <izz>0.16666666666666666</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.65 0.55 1</ambient>
            <diffuse>0.15 0.65 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 黄色探针：动态刚体，尺寸 0.3 m；模型原点特意与几何中心、质心重合。 -->
    <model name="solid_probe">
      <static>false</static>
      <pose>-1 0 2.5 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.015</ixx>
            <iyy>0.015</iyy>
            <izz>0.015</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 紫色探针：与黄色探针物理参数相同，用于比较两条落体通路。 -->
    <model name="ghost_probe">
      <static>false</static>
      <pose>1 0 2.5 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.015</ixx>
            <iyy>0.015</iyy>
            <izz>0.015</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.65 1</ambient>
            <diffuse>0.8 0.2 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <gui>
      <camera name="user_camera">
        <pose>7 -8 6 0 0.45 2.3</pose>
      </camera>
    </gui>
  </world>
</sdf>
