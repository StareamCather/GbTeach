{
  "id": "22",
  "title": "ROS启动：让节点、参数与Gazebo接通",
  "module": "ROS系统集成",
  "order": 22,
  "summary": "用真实roslaunch组织两个节点，通过有限力脉冲验证命名空间、参数、重映射与反馈。",
  "profile": "classic11-noetic",
  "requires_ros": true,
  "requires_plugins": ["libgazebo_ros_api_plugin.so"],
  "requires_ros_packages": ["rospy", "std_msgs", "std_srvs", "gazebo_msgs", "geometry_msgs", "roslaunch"],
  "requires_tools": ["roslaunch", "rospack", "rosparam", "rosservice", "rostopic"],
  "ros_package_paths": ["ros_ws/src"],
  "world": "world.sdf",
  "prepare": ["python3 prepare.py"],
  "prepare_timeout": 45,
  "after_start": ["python3 lab.py world-ready"],
  "startup": [{"name": "ROSlaunch教学节点", "title": "驱动与反馈节点", "command": "bash ros_lab.sh start"}],
  "after_startup": ["python3 lab.py ready"],
  "after_startup_timeout": 40,
  "verify": "verify.py",
  "verify_timeout": 120,
  "reference": "reference.md",
  "objectives": ["在现有私有ROS Master和Gazebo上启动本课节点", "使用package、arg、include、私有参数、namespace和remap", "验证真实ROS图、服务调用和物理反馈"],
  "commands": [
    {"title": "发现私有ROS包", "command": "rospack find gazeboteach_l22"},
    {"title": "解析启动节点", "command": "bash ros_lab.sh nodes"},
    {"title": "查看启动参数", "command": "bash ros_lab.sh params"},
    {"title": "观察实际状态反馈", "command": "python3 lab.py observe --seconds 2"},
    {"title": "施加一次有限力脉冲", "command": "python3 lab.py pulse"},
    {"title": "取消施力（保留惯性）", "command": "python3 lab.py cancel"},
    {"title": "重置本课滑块", "command": "python3 lab.py reset"},
    {"title": "ROS图与物理响应验收", "command": "python3 verify.py"}
  ]
}
