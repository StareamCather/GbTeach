<launch>
  <param name="/use_sim_time" value="true" type="bool"/>
  <arg name="robot_ns" default="cart_a"/>
  <arg name="force_n" default="2"/>
  <include file="$(find gazeboteach_l22)/launch/nodes.launch">
    <arg name="robot_ns" value="$(arg robot_ns)"/>
    <arg name="force_n" value="$(arg force_n)"/>
  </include>
</launch>
