<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <world name="lesson16">
    <gravity>0 0 -9.81</gravity>
    <physics name="teaching_ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>60</iters>
        </solver>
      </ode>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.08 0.12 0.18 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="classroom_light" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.31 0.34 1</ambient>
            <diffuse>0.35 0.38 0.41 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5 -6 5 0 0.45 0.8</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <model name="turntable">
      <pose>0 0 1 0 0 0</pose>
      <link name="imu_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.0064083333333333327</ixx>
            <iyy>0.031200000000000002</iyy>
            <izz>0.035208333333333335</izz>
          </inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>.6 .25 .12</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.25 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.4 1</ambient>
            <diffuse>0.1 0.7 0.4 1</diffuse>
          </material>
        </visual>
        <sensor name="imu" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <imu/>
          <plugin name="imu_ros" filename="libgazebo_ros_imu_sensor.so">
            <robotNamespace>/lesson16</robotNamespace>
            <topicName>/lesson16/imu</topicName>
            <frameName>imu_link</frameName>
            <updateRateHZ>200</updateRateHZ>
            <gaussianNoise>0</gaussianNoise>
            <initialOrientationAsReference>false</initialOrientationAsReference>
            <xyzOffset>0 0 0</xyzOffset>
            <rpyOffset>0 0 0</rpyOffset>
          </plugin>
          <pose>0 0 0 0 0 0</pose>
        </sensor>
        <pose>0 0 0 0 0 0</pose>
        <kinematic>false</kinematic>
        <velocity_decay>
          <linear>0</linear>
          <angular>0</angular>
        </velocity_decay>
      </link>
      <static>false</static>
    </model>
    <model name="freefall_probe">
      <pose>2 0 3 0 0 0</pose>
      <link name="freefall_link">
        <gravity>true</gravity>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.006666666666666668</ixx>
            <iyy>0.006666666666666668</iyy>
            <izz>0.006666666666666668</izz>
          </inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>.2 .2 .2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>.2 .2 .2</size>
            </box>
          </geometry>
          <material>
            <ambient>.85 .25 .1 1</ambient>
            <diffuse>.85 .25 .1 1</diffuse>
          </material>
        </visual>
        <sensor name="freefall_imu" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <imu/>
          <plugin name="freefall_imu_ros" filename="libgazebo_ros_imu_sensor.so">
            <robotNamespace>/lesson16</robotNamespace>
            <topicName>/lesson16/freefall_imu</topicName>
            <frameName>freefall_link</frameName>
            <updateRateHZ>200</updateRateHZ>
            <gaussianNoise>0</gaussianNoise>
            <initialOrientationAsReference>false</initialOrientationAsReference>
            <xyzOffset>0 0 0</xyzOffset>
            <rpyOffset>0 0 0</rpyOffset>
          </plugin>
          <pose>0 0 0 0 0 0</pose>
        </sensor>
        <pose>0 0 0 0 0 0</pose>
        <kinematic>false</kinematic>
        <velocity_decay>
          <linear>0</linear>
          <angular>0</angular>
        </velocity_decay>
      </link>
      <static>false</static>
    </model>
  </world>
</sdf>
