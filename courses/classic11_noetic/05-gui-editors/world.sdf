<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.82 0.87 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="surface">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.68 0.72 1</ambient>
            <diffuse>0.65 0.68 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <gui>
      <camera name="user_camera">
        <pose>8 -11 8 0 .45 2.2</pose>
      </camera>
    </gui>
    <include>
      <uri>model://reference_table</uri>
      <name>table_example</name>
      <pose>-2.3 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://reference_room</uri>
      <name>room_example</name>
      <pose>2.3 0 0 0 0 0</pose>
    </include>
    <model name="table_probe">
      <pose>-2.3 0 1.6 0 0 0</pose>
      <static>false</static>
      <link name="probe">
        <pose>0 0 0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>.95 .25 .08 1</ambient>
            <diffuse>.95 .25 .08 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>.2</mass>
          <inertia>
            <ixx>0.00033333333333333343</ixx>
            <iyy>0.00033333333333333343</iyy>
            <izz>0.00033333333333333343</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    <!-- 从左前上方完整观察桌子与门洞，并给新建零件留出中间视线。 -->
    <gui>
      <camera name="user_camera">
        <pose>-7 -9 6 0 0.43 0.91</pose>
      </camera>
    </gui>
  </world>
</sdf>
