<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <world name="lesson17">
    <gravity>0 0 -9.81</gravity>
    <physics name="teaching_ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>60</iters>
        </solver>
      </ode>
    </physics>
    <scene>
      <ambient>.4 .4 .4 1</ambient>
      <background>.025 .03 .04 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="classroom_light" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.31 0.34 1</ambient>
            <diffuse>0.35 0.38 0.41 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5 -6 5 0 0.45 0.8</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <model name="camera_rig">
      <static>true</static>
      <pose>0 0 1 0 0 0</pose>
      <link name="camera_link">
        <sensor name="rgb_camera" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
          <camera name="rgb">
            <horizontal_fov>1.0471975511965976</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>.1</near>
              <far>20</far>
            </clip>
          </camera>
          <plugin name="rgb_ros" filename="libgazebo_ros_camera.so">
            <robotNamespace>/lesson17</robotNamespace>
            <cameraName>camera</cameraName>
            <imageTopicName>/lesson17/camera/image_raw</imageTopicName>
            <cameraInfoTopicName>/lesson17/camera/camera_info</cameraInfoTopicName>
            <frameName>camera_optical_frame</frameName>
            <updateRate>0</updateRate>
            <hackBaseline>0</hackBaseline>
            <distortionK1>0</distortionK1>
            <distortionK2>0</distortionK2>
            <distortionK3>0</distortionK3>
            <distortionT1>0</distortionT1>
            <distortionT2>0</distortionT2>
          </plugin>
        </sensor>
      </link>
    </model>
    <model name="target_red">
      <static>true</static>
      <pose>3 0 1 0 0 0</pose>
      <link name="link">
        <visual name="panel">
          <geometry>
            <box>
              <size>.04 .6 .6</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>1 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <model name="fiducial_green">
      <static>true</static>
      <pose>3 -1 1 0 0 0</pose>
      <link name="link">
        <visual name="panel">
          <geometry>
            <box>
              <size>.04 .25 .25</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 1 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <model name="fiducial_blue">
      <static>true</static>
      <pose>3 0 1.9 0 0 0</pose>
      <link name="link">
        <visual name="panel">
          <geometry>
            <box>
              <size>.04 .25 .25</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 1 1</emissive>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
