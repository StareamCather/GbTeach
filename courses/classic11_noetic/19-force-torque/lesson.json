{
  "id": "19",
  "title": "六维力矩：称重、力臂与测量坐标",
  "module": "感知与传感器",
  "summary": "用真实固定关节承载偏心质量，比较原生力矩传感器与ROS关节反馈。",
  "order": 19,
  "profile": "classic11-noetic",
  "requires_ros": true,
  "requires_plugins": ["libgazebo_ros_api_plugin.so", "libgazebo_ros_ft_sensor.so"],
  "requires_ros_packages": ["gazebo_plugins", "gazebo_msgs", "geometry_msgs", "rospy", "roscpp"],
  "requires_tools": ["rostopic", "rospack", "g++", "pkg-config"],
  "world": "world.sdf",
  "prepare": ["python3 prepare.py"],
  "prepare_timeout": 150,
  "after_start": ["python3 lab.py ready"],
  "verify": "verify.py",
  "verify_timeout": 90,
  "reference": "reference.md",
  "objectives": [
    "用真实关节反馈验证重力和r叉乘F力矩",
    "区分测量方向、坐标基与力矩参考点",
    "比较三路原生ForceTorqueSensor与ROS ModelPlugin",
    "通过质量和力臂单变量实验解释六维wrench"
  ],
  "commands": [
    {"title": "读取原生传感器数据", "command": "rostopic echo -n 1 /lesson19/native_child"},
    {"title": "读取stock ROS关节反馈", "command": "rostopic echo -n 1 /lesson19/stock_wrench"},
    {"title": "比较四路真实力矩", "command": "python3 lab.py observe --seconds 3"},
    {"title": "修改负载质量并准备重载", "command": "python3 lab.py config --mass 2"},
    {"title": "真实称重与力臂验收", "command": "python3 verify.py"}
  ],
  "requires_pkg_config": {
    "gazebo": "11.15.1",
    "roscpp": "",
    "geometry_msgs": ""
  },
  "requires_native_server": true
}
