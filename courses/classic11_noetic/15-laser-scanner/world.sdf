<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <world name="lesson15">
    <gravity>0 0 -9.81</gravity>
    <physics name="teaching_ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>60</iters>
        </solver>
      </ode>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.08 0.12 0.18 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="classroom_light" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.31 0.34 1</ambient>
            <diffuse>0.35 0.38 0.41 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5 -6 5 0 0.45 0.8</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <model name="scanner">
      <static>true</static>
      <pose>0 0 0.7 0 0 0</pose>
      <link name="laser_link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.9 1</ambient>
            <diffuse>0.1 0.4 0.9 1</diffuse>
          </material>
          <pose>0 0 -0.15 0 0 0</pose>
        </visual>
        <sensor name="cpu_scan" type="ray">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>20</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>181</samples>
                <resolution>1</resolution>
                <min_angle>-1.5707963267948966</min_angle>
                <max_angle>1.5707963267948966</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>10</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0</stddev>
            </noise>
          </ray>
          <plugin name="cpu_scan_ros" filename="libgazebo_ros_laser.so">
            <robotNamespace>/lesson15</robotNamespace>
            <topicName>/lesson15/scan</topicName>
            <frameName>laser_frame</frameName>
          </plugin>
        </sensor>
        <sensor name="gpu_scan" type="gpu_ray">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>20</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>181</samples>
                <resolution>1</resolution>
                <min_angle>-1.5707963267948966</min_angle>
                <max_angle>1.5707963267948966</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>10</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0</stddev>
            </noise>
          </ray>
          <plugin name="gpu_scan_ros" filename="libgazeboteach_l15_gpu_laser.so">
            <robotNamespace>/lesson15</robotNamespace>
            <topicName>/lesson15/gpu_scan</topicName>
            <frameName>laser_frame</frameName>
          </plugin>
        </sensor>
      </link>
    </model>
    <model name="target_wall">
      <static>true</static>
      <pose>3 0 1 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>5.666666666666667</ixx>
            <iyy>0.33666666666666667</iyy>
            <izz>5.336666666666667</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 8 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 8 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.65 0.15 1</ambient>
            <diffuse>0.85 0.65 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="collision_only">
      <static>true</static>
      <pose>1.5 -1.5 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 0.4 0.4</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="visual_only">
      <static>true</static>
      <pose>1.5 1.5 0.7 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 0.4 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.15 0.7 1</ambient>
            <diffuse>0.8 0.15 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
