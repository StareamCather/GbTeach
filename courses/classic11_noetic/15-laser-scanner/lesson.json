{
  "id": "15",
  "title": "激光扫描：距离如何变成数组",
  "module": "感知与传感器",
  "summary": "用数组角度、多束墙面测距与碰撞/可见几何对照，解释CPU ray与GPU ray的差别。",
  "order": 15,
  "profile": "classic11-noetic",
  "requires_ros": true,
  "requires_plugins": ["libgazebo_ros_api_plugin.so", "libgazebo_ros_laser.so"],
  "requires_ros_packages": ["gazebo_plugins", "gazebo_msgs", "sensor_msgs", "rospy", "roscpp"],
  "requires_tools": ["rostopic", "rospack", "g++", "pkg-config"],
  "prepare": ["python3 prepare.py"],
  "prepare_timeout": 150,
  "after_start": ["python3 lab.py ready"],
  "verify_timeout": 100,
  "reference": "reference.md",
  "world": "world.sdf",
  "objectives": [
    "解释LaserScan索引和角度的对应关系",
    "比较ray与gpu_ray的几何来源",
    "用可控目标验证测距结果"
  ],
  "commands": [
    {
      "title": "读取双路扫描摘要",
      "command": "python3 lab.py observe --seconds 3"
    },
    {
      "title": "查看CPU扫描",
      "command": "rostopic echo -n 1 /lesson15/scan"
    },
    {
      "title": "比较两路频率",
      "command": "rostopic hz /lesson15/gpu_scan"
    },
    {
      "title": "移动墙体验收",
      "command": "python3 verify.py"
    }
  ],
  "verify": "verify.py",
  "needs_display": true,
  "requires_pkg_config": {
    "gazebo": "11.15.1",
    "roscpp": "",
    "sensor_msgs": ""
  },
  "requires_native_server": true
}
