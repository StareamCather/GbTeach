<sdf version="1.6"><world name="lesson39"><physics type="ode"><max_step_size>.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics><gravity>0 0 -9.81</gravity><scene><ambient>1 1 1 1</ambient><background>.1 .12 .15 1</background><shadows>true</shadows></scene><model name="card_left"><static>true</static><pose>4 1.8 1.5 0 0 0</pose><link name="panel"><visual name="uv_quad"><geometry><mesh><uri>model://texture_cards/meshes/left.dae</uri></mesh></geometry><material><lighting>false</lighting><script><uri>model://texture_cards/materials/scripts/cards.material</uri><uri>model://texture_cards/materials/textures</uri><name>GT/Checker</name></script></material></visual></link></model><model name="card_right"><static>true</static><pose>4 0 1.5 0 0 0</pose><link name="panel"><visual name="uv_quad"><geometry><mesh><uri>model://texture_cards/meshes/right.dae</uri></mesh></geometry><material><lighting>false</lighting><script><uri>model://texture_cards/materials/scripts/cards.material</uri><uri>model://texture_cards/materials/textures</uri><name>GT/Checker</name></script></material></visual></link></model><model name="blue_back"><static>true</static><pose>4.1 -1.8 1.5 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size> .08 1.6 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size> .08 1.6 1.6</size></box></geometry><material><ambient>0 .05 1 1</ambient><diffuse>0 .05 1 1</diffuse></material></visual></link></model><model name="glass"><static>true</static><pose>3.95 -1.8 1.5 0 0 0</pose><link name="panel"><visual name="glass"><geometry><mesh><uri>model://texture_cards/meshes/glass.dae</uri></mesh></geometry><material><script><uri>model://texture_cards/materials/scripts/glass.material</uri><name>GT/Glass</name></script></material></visual></link></model><model name="measurement_camera"><static>true</static><pose>0 0 1.5 0 0 0</pose><link name="mount"><sensor name="camera" type="camera"><always_on>true</always_on><update_rate>15</update_rate><camera><horizontal_fov>1.3</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>.05</near><far>20</far></clip></camera><plugin name="actual_frame" filename="libgt_camera.so"/></sensor></link></model><gui fullscreen="0"><camera name="user_camera"><pose>-4 -6 5 0 .42 .75</pose><view_controller>orbit</view_controller></camera></gui></world></sdf>