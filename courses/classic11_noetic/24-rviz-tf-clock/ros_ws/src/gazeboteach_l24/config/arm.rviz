Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: /lesson24/robot_description
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.25
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.6
      Focal Point:
        X: 0.35
        Y: 0
        Z: 0.7
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 760
