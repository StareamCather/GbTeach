<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="beam" params="name length mass color">
    <link name="${name}">
      <visual name="${name}_visual"><origin xyz="${length/2} 0 0"/><geometry><box size="${length} 0.06 0.06"/></geometry><material name="${color}"/></visual>
      <collision name="${name}_collision"><origin xyz="${length/2} 0 0"/><geometry><box size="${length} 0.06 0.06"/></geometry></collision>
      <inertial><origin xyz="${length/2} 0 0"/><mass value="${mass}"/>
        <inertia ixx="${mass*(0.06**2+0.06**2)/12}" iyy="${mass*(length**2+0.06**2)/12}" izz="${mass*(length**2+0.06**2)/12}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <gazebo reference="${name}"><gravity>false</gravity><selfCollide>false</selfCollide><material>Gazebo/${color}</material></gazebo>
  </xacro:macro>
</robot>
