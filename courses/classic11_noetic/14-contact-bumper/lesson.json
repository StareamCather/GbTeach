{
  "id": "14",
  "title": "碰撞保险杠：接触发生了什么",
  "module": "感知与传感器",
  "summary": "用落在保险杠上的方块观察碰撞对象、接触点与支持力。",
  "order": 14,
  "profile": "classic11-noetic",
  "requires_ros": true,
  "requires_plugins": ["libgazebo_ros_bumper.so", "libgazebo_ros_api_plugin.so"],
  "requires_ros_packages": ["gazebo_plugins", "gazebo_msgs", "rospy"],
  "requires_tools": ["rostopic", "rospack"],
  "prepare": ["python3 prepare.py"],
  "after_start": ["python3 lab.py ready"],
  "verify_timeout": 75,
  "reference": "reference.md",
  "world": "world.sdf",
  "objectives": [
    "区分接触事件与距离检测",
    "读取真实ContactsState并定位碰撞对象",
    "用自由落体与静止支持力解释接触输出"
  ],
  "commands": [
    {
      "title": "观察真实接触",
      "command": "rostopic echo /lesson14/contacts"
    },
    {
      "title": "重新释放方块",
      "command": "python3 drop.py --height 1.8"
    },
    {
      "title": "只读接触摘要",
      "command": "python3 lab.py observe --seconds 3"
    },
    {
      "title": "自动验收",
      "command": "python3 verify.py"
    }
  ],
  "verify": "verify.py"
}
