<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <world name="lesson14">
    <gravity>0 0 -9.81</gravity>
    <physics name="teaching_ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>60</iters>
        </solver>
      </ode>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.08 0.12 0.18 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="classroom_light" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.31 0.34 1</ambient>
            <diffuse>0.35 0.38 0.41 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5 -6 5 0 0.45 0.8</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <model name="bumper">
      <static>true</static>
      <pose>0 0 0.1 0 0 0</pose>
      <link name="plate">
        <collision name="bumper_collision">
          <geometry>
            <box>
              <size>1.4 1.4 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.4 1.4 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.9 1</ambient>
            <diffuse>0.1 0.6 0.9 1</diffuse>
          </material>
        </visual>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact>
            <collision>bumper_collision</collision>
          </contact>
          <plugin name="bumper_ros" filename="libgazebo_ros_bumper.so">
            <robotNamespace>/lesson14</robotNamespace>
            <bumperTopicName>/lesson14/contacts</bumperTopicName>
            <frameName>world</frameName>
          </plugin>
        </sensor>
      </link>
    </model>
    <model name="puck">
      <static>false</static>
      <pose>0 0 1.4 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.013541666666666665</ixx>
            <iyy>0.013541666666666665</iyy>
            <izz>0.020416666666666663</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 0.35 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 0.35 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.25 0.1 1</ambient>
            <diffuse>0.9 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
