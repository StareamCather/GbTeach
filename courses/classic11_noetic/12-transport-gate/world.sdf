<?xml version="1.0"?>
<sdf version="1.7"><world name="default">
  <gravity>0 0 -9.81</gravity>
  <physics name="ode" type="ode"><max_step_size>.001</max_step_size><real_time_update_rate>1000</real_time_update_rate><ode><solver><type>quick</type><iters>100</iters></solver></ode></physics>
  <scene><ambient>.6 .6 .6 1</ambient><background>.84 .89 .95 1</background><shadows>true</shadows></scene>
