  "module": "关节与机构",
  "summary": "用几行 Python 将串联双杆的相对关节角转为六维绝对状态，再对真实小车双级倒立摆作局部反馈控制。",
  "order": 9,
  "profile": "classic11-noetic",
  "requires_ros": false,
  "requires_tools": ["g++", "pkg-config", "python3-config"],
  "world": "world.sdf",
  "server_args": ["--seed", "42"],
