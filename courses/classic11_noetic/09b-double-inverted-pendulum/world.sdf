<?xml version="1.0"?>
<sdf version="1.7">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>100</iters></solver><constraints><cfm>0</cfm><erp>0.2</erp></constraints></ode>
    </physics>
    <scene><ambient>.5 .5 .5 1</ambient><background>.84 .89 .95 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>.9 .9 .9 1</diffuse><direction>-.5 .1 -1</direction></light>
    <gui><camera name="user_camera"><pose>2.7 -5.2 2.6 0 .22 2.05</pose></camera></gui>
    <model name="track"><static>true</static><pose>0 0 .18 0 0 0</pose><link name="track_visual">
      <visual name="rail"><geometry><box><size>3.5 .12 .08</size></box></geometry><material><ambient>.24 .27 .32 1</ambient><diffuse>.24 .27 .32 1</diffuse></material></visual>
      <visual name="origin"><pose>0 -.16 -.03 0 0 0</pose><geometry><box><size>.018 .35 .02</size></box></geometry><material><ambient>.9 .25 .18 1</ambient><diffuse>.9 .25 .18 1</diffuse></material></visual>
      <visual name="left_marker"><pose>-1.5 0 0 0 0 0</pose><geometry><box><size>.025 .4 .12</size></box></geometry><material><ambient>.9 .55 .1 1</ambient><diffuse>.9 .55 .1 1</diffuse></material></visual>
      <visual name="right_marker"><pose>1.5 0 0 0 0 0</pose><geometry><box><size>.025 .4 .12</size></box></geometry><material><ambient>.9 .55 .1 1</ambient><diffuse>.9 .55 .1 1</diffuse></material></visual>
    </link></model>
    <model name="floor"><static>true</static><link name="floor_visual"><visual name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>.72 .75 .79 1</ambient><diffuse>.72 .75 .79 1</diffuse></material></visual></link></model>
    <model name="double_cartpole">
      <static>false</static><allow_auto_disable>false</allow_auto_disable><self_collide>false</self_collide>
      <link name="cart">
        <pose>0 0 .35 0 0 0</pose><gravity>true</gravity><velocity_decay><linear>0</linear><angular>0</angular></velocity_decay>
        <inertial><mass>1</mass><inertia><ixx>.00813333333333333</ixx><iyy>.0141333333333333</iyy><izz>.0156</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="cart_collision"><geometry><box><size>.36 .24 .2</size></box></geometry></collision>
        <visual name="cart_visual"><geometry><box><size>.36 .24 .2</size></box></geometry><material><ambient>.08 .38 .75 1</ambient><diffuse>.08 .38 .75 1</diffuse></material></visual>
      </link>
      <joint name="cart_slide" type="prismatic">
        <parent>world</parent><child>cart</child><pose relative_to="cart">0 0 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">1 0 0</xyz><limit><lower>-1.5</lower><upper>1.5</upper><effort>25</effort><velocity>5</velocity></limit><dynamics><damping>.05</damping><friction>0</friction></dynamics></axis>
      </joint>
      <link name="pole">
        <pose>0 0 .77 0 0 0</pose><gravity>true</gravity><velocity_decay><linear>0</linear><angular>0</angular></velocity_decay>
        <inertial><mass>.2</mass><inertia><ixx>.00601125</ixx><iyy>.00601125</iyy><izz>.0000225</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="pole_collision"><geometry><cylinder><radius>.015</radius><length>.6</length></cylinder></geometry></collision>
        <visual name="pole_visual"><geometry><cylinder><radius>.015</radius><length>.6</length></cylinder></geometry><material><ambient>.95 .4 .12 1</ambient><diffuse>.95 .4 .12 1</diffuse></material></visual>
        <visual name="tip_marker"><pose>0 0 .3 0 0 0</pose><geometry><sphere><radius>.037</radius></sphere></geometry><material><ambient>.9 .15 .12 1</ambient><diffuse>.9 .15 .12 1</diffuse></material></visual>
      </link>
      <joint name="pole_hinge" type="revolute">
        <parent>cart</parent><child>pole</child><pose relative_to="cart">0 0 .12 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>0</effort><velocity>100</velocity></limit><dynamics><damping>.002</damping><friction>0</friction></dynamics></axis>
      </joint>
      <link name="pole2">
        <pose>0 0 1.32 0 0 0</pose><gravity>true</gravity><velocity_decay><linear>0</linear><angular>0</angular></velocity_decay>
        <inertial><mass>.15</mass><inertia><ixx>.0031334375</ixx><iyy>.0031334375</iyy><izz>.000016875</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="pole2_collision"><geometry><cylinder><radius>.015</radius><length>.5</length></cylinder></geometry></collision>
        <visual name="pole2_visual"><geometry><cylinder><radius>.015</radius><length>.5</length></cylinder></geometry><material><ambient>.08 .65 .4 1</ambient><diffuse>.08 .65 .4 1</diffuse></material></visual>
        <visual name="tip_marker"><pose>0 0 .25 0 0 0</pose><geometry><sphere><radius>.035</radius></sphere></geometry><material><ambient>.15 .8 .45 1</ambient><diffuse>.15 .8 .45 1</diffuse></material></visual>
      </link>
      <joint name="pole_hinge_2" type="revolute">
        <parent>pole</parent><child>pole2</child><pose relative_to="pole">0 0 .3 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>0</effort><velocity>100</velocity></limit><dynamics><damping>.002</damping><friction>0</friction></dynamics></axis>
      </joint>
      <plugin name="python_cart_force" filename="libgazeboteach_python_control.so"><poles>2</poles></plugin>
    </model>
  </world>
</sdf>
