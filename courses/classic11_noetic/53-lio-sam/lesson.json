{
  "id": "53",
  "title": "LIO-SAM：IMU 预积分、iSAM2 和真实回环因子",
  "module": "附加专项·激光惯性里程计",
  "order": 53,
  "profile": "classic11-noetic",
  "requires_ros": true,
  "requires_tools": [
    "g++",
    "pkg-config",
    "catkin_make",
    "rosbag"
  ],
  "requires_plugins": [
    "libgazebo_ros_imu_sensor.so"
  ],
  "requires_ros_packages": [
    "gazebo_plugins",
    "pcl_ros",
    "pcl_conversions",
    "eigen_conversions"
  ],
  "requires_python_modules": [
    "numpy"
  ],
  "requires_pkg_config": {
    "gazebo": "11.15.1"
  },
  "requires_native_server": true,
  "graceful_server_shutdown": true,
  "world": "world.sdf",
  "prepare": [
    "python3 prepare.py",
    "python3 build_lio_sam.py --download"
  ],
  "prepare_timeout": 3700,
  "after_startup": [
    "python3 native_ready.py"
  ],
  "verify": "verify.py",
  "verify_timeout": 380,
  "reference": "reference.md",
  "objectives": [
    "用可计算例子解释因子残差、白化与状态估计",
    "跟踪真实预积分因子和两个 iSAM2 图的职责",
    "在同一录包中验证实际回环因子及关键帧和地图变化"
  ],
  "commands": [
    {
      "title": "采集闭合路线并比较回环关闭／开启",
      "command": "python3 adapter.py run"
    },
    {
      "title": "编辑白化与加权估计练习",
      "command": "gedit --new-window learner.py"
    },
    {
      "title": "检查个人练习",
      "command": "python3 student_check.py"
    }
  ]
}
