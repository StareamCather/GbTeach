<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <!-- 长度单位是米，时间单位是秒；重力朝世界坐标的 -z 方向。 -->
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.82 0.87 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <!-- 灯光和地面直接定义在本文件中，首课不需要联网下载资源。 -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="surface">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.68 0.72 1</ambient>
            <diffuse>0.65 0.68 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="falling_block">
      <static>false</static>
      <!-- pose = x y z roll pitch yaw；模型原点就是方块的几何中心。 -->
      <pose>0 0 3 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.0</mass>
          <!-- 均匀立方体 Ixx = Iyy = Izz = m * 边长² / 6。 -->
          <inertia>
            <ixx>0.041666666666666664</ixx>
            <iyy>0.041666666666666664</iyy>
            <izz>0.041666666666666664</izz>
          </inertia>
        </inertial>
        <!-- collision 参与碰撞检测；visual 只决定显示。改边长时同步改两处。 -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.55 0.95 1</ambient>
            <diffuse>0.12 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>7 -8 6 0 0.45 2.3</pose>
      </camera>
    </gui>
  </world>
</sdf>
