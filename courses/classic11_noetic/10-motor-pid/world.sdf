<?xml version="1.0"?>
<sdf version="1.7">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>100</iters></solver></ode>
    </physics>
    <scene><ambient>.55 .55 .55 1</ambient><background>.84 .89 .95 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>.9 .9 .9 1</diffuse><direction>-.5 .1 -1</direction></light>
    <gui><camera name="user_camera"><pose>1.65 -2.4 2.1 0 .5 2.15</pose></camera></gui>
    <model name="stand"><static>true</static><link name="visual_reference">
      <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>.72 .75 .79 1</ambient><diffuse>.72 .75 .79 1</diffuse></material></visual>
      <visual name="base"><pose>0 0 .15 0 0 0</pose><geometry><box><size>.65 .65 .3</size></box></geometry><material><ambient>.15 .22 .32 1</ambient><diffuse>.15 .22 .32 1</diffuse></material></visual>
      <visual name="shaft"><pose>0 0 .4 0 0 0</pose><geometry><cylinder><radius>.035</radius><length>.3</length></cylinder></geometry><material><ambient>.4 .42 .45 1</ambient><diffuse>.4 .42 .45 1</diffuse></material></visual>
      <visual name="zero_mark"><pose>.31 0 .6 0 0 0</pose><geometry><box><size>.08 .02 .02</size></box></geometry><material><ambient>.9 .2 .12 1</ambient><diffuse>.9 .2 .12 1</diffuse></material></visual>
      <visual name="quarter_mark"><pose>0 .31 .6 0 0 0</pose><geometry><box><size>.02 .08 .02</size></box></geometry><material><ambient>.2 .65 .3 1</ambient><diffuse>.2 .65 .3 1</diffuse></material></visual>
    </link></model>
    <model name="motor_rig">
      <static>false</static><allow_auto_disable>false</allow_auto_disable><self_collide>false</self_collide>
      <link name="rotor">
        <pose>0 0 .6 0 0 0</pose><gravity>true</gravity>
        <velocity_decay><linear>0</linear><angular>0</angular></velocity_decay>
        <inertial><mass>1</mass><inertia><ixx>.015925</ixx><iyy>.015925</iyy><izz>.03125</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="rotor_collision"><geometry><cylinder><radius>.25</radius><length>.06</length></cylinder></geometry></collision>
        <visual name="disk"><geometry><cylinder><radius>.25</radius><length>.06</length></cylinder></geometry><material><ambient>.12 .45 .8 1</ambient><diffuse>.12 .45 .8 1</diffuse></material></visual>
        <visual name="pointer"><pose>.13 0 .035 0 0 0</pose><geometry><box><size>.23 .025 .012</size></box></geometry><material><ambient>1 .65 .08 1</ambient><diffuse>1 .65 .08 1</diffuse></material></visual>
      </link>
      <joint name="rotor_joint" type="revolute">
        <parent>world</parent><child>rotor</child><pose relative_to="rotor">0 0 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>3</effort><velocity>100</velocity></limit><dynamics><damping>.1</damping><friction>0</friction></dynamics></axis><physics><ode><implicit_spring_damper>false</implicit_spring_damper></ode></physics>
      </joint>
      <plugin name="bounded_motor_laboratory" filename="libgazeboteach_motor_lab.so"/>
    </model>
  </world>
</sdf>
