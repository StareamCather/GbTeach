        </inertial>
        <collision name="wheel_collision">
          <pose>0 0 0 1.5707963267948966 0 0</pose>
          <geometry>
            <cylinder>
              <radius>.1</radius>
              <length>.01</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>.8</mu>
                <mu2>.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wheel">
