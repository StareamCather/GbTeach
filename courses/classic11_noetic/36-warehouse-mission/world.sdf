              <size>.15 .005 .012</size>
            </box>
          </geometry>
          <material>
            <ambient>1 .75 .1 1</ambient>
            <diffuse>1 .75 .1 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="right_wheel">
        <pose>0 -.18 .1002 0 0 0</pose>
        <inertial>
          <mass>.2</mass>
          <inertia>
            <ixx>.000501666666666667</ixx>
            <iyy>.001</iyy>
