          <geometry>
            <box>
              <size>.15 .005 .012</size>
            </box>
          </geometry>
          <material>
            <ambient>1 .75 .1 1</ambient>
            <diffuse>1 .75 .1 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="caster">
        <pose>-.2 0 .0352 0 0 0</pose>
        <inertial>
          <mass>.05</mass>
          <inertia>
            <ixx>.0000245</ixx>
            <iyy>.0000245</iyy>
            <izz>.0000245</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="caster_collision">
          <geometry>
            <sphere>
              <radius>.035</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>.001</mu>
                <mu2>.001</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="support">
          <geometry>
            <sphere>
              <radius>.035</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>.5 .52 .55 1</ambient>
            <diffuse>.5 .52 .55 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="warehouse_left_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <pose relative_to="left_wheel">0 0 0 0 0 0</pose>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1000000</lower>
            <upper>1000000</upper>
            <effort>10</effort>
            <velocity>30</velocity>
          </limit>
          <dynamics>
            <damping>0</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="warehouse_right_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <pose relative_to="right_wheel">0 0 0 0 0 0</pose>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1000000</lower>
            <upper>1000000</upper>
            <effort>10</effort>
            <velocity>30</velocity>
          </limit>
          <dynamics>
            <damping>0</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="warehouse_caster_fixed" type="fixed">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>
      <pose>-1.6 0 0 0 0 0</pose>
      <plugin name="warehouse_differential_drive" filename="libgazebo_ros_diff_drive.so">
        <robotNamespace>/warehouse</robotNamespace>
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>warehouse/odom</odometryFrame>
        <robotBaseFrame>warehouse/base_footprint</robotBaseFrame>
        <leftJoint>warehouse_left_joint</leftJoint>
        <rightJoint>warehouse_right_joint</rightJoint>
        <wheelSeparation>.36</wheelSeparation>
        <wheelDiameter>.2</wheelDiameter>
        <odometrySource>world</odometrySource>
        <publishTf>true</publishTf>
        <publishOdomTF>true</publishOdomTF>
        <publishWheelTF>false</publishWheelTF>
        <publishWheelJointState>true</publishWheelJointState>
        <updateRate>50</updateRate>
        <wheelTorque>5</wheelTorque>
        <wheelAcceleration>0</wheelAcceleration>
      </plugin>
