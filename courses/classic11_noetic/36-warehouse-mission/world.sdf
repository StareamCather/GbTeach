        </visual>
        <visual name="forward">
          <pose>.075 0 .046 0 0 0</pose>
          <geometry>
            <box>
              <size>.055 .025 .012</size>
            </box>
          </geometry>
          <material>
            <ambient>1 .6 .08 1</ambient>
            <diffuse>1 .6 .08 1</diffuse>
          </material>
        </visual>
        <sensor name="warehouse_laser" type="ray">
          <pose>.15 0 .09 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>361</samples>
                <resolution>1</resolution>
                <min_angle>-1.5707963267948966</min_angle>
                <max_angle>1.5707963267948966</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>.06</min>
              <max>8</max>
              <resolution>.005</resolution>
            </range>
          </ray>
          <plugin name="warehouse_ros_laser" filename="libgazebo_ros_laser.so">
            <robotNamespace>/warehouse</robotNamespace>
            <topicName>scan</topicName>
            <frameName>warehouse/laser</frameName>
          </plugin>
        </sensor>
        <sensor name="warehouse_bumper" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact>
            <collision>chassis_collision</collision>
          </contact>
          <plugin name="warehouse_ros_bumper" filename="libgazebo_ros_bumper.so">
            <robotNamespace>/warehouse</robotNamespace>
            <bumperTopicName>bumper</bumperTopicName>
            <frameName>warehouse/base_footprint</frameName>
          </plugin>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0 .18 .1002 0 0 0</pose>
        <inertial>
