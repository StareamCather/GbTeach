            </box>
          </geometry>
          <material>
            <ambient>.1 .75 .35 1</ambient>
            <diffuse>.1 .75 .35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="warehouse_bot">
      <static>false</static>
      <self_collide>false</self_collide>
      <allow_auto_disable>false</allow_auto_disable>
      <link name="chassis">
        <pose>0 0 .1302 0 0 0</pose>
        <inertial>
          <pose>-.10 0 0 0 0 0</pose>
          <mass>2</mass>
          <inertia>
            <ixx>.0106666666666667</ixx>
            <iyy>.0304666666666667</iyy>
            <izz>.039</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
