<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.7">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <friction_model>pyramid_model</friction_model>
        </solver>
      </ode>
    </physics>
    <scene>
      <ambient>.6 .6 .6 1</ambient>
      <background>.84 .89 .95 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>.9 .9 .9 1</diffuse>
      <direction>-.5 .1 -1</direction>
    </light>
    <gui>
      <camera name="user_camera">
        <pose>4.8 -5.7 5.5 0 .65 2.15</pose>
      </camera>
    </gui>
    <model name="floor">
      <static>true</static>
      <link name="ground">
        <collision name="floor_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>.8</mu>
                <mu2>.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>.72 .76 .8 1</ambient>
            <diffuse>.72 .76 .8 1</diffuse>
          </material>
        </visual>
        <visual name="x_reference">
          <pose>1 0 .001 0 0 0</pose>
          <geometry>
            <box>
              <size>2 .012 .002</size>
            </box>
          </geometry>
          <material>
            <ambient>.8 .22 .16 1</ambient>
            <diffuse>.8 .22 .16 1</diffuse>
          </material>
        </visual>
        <visual name="y_reference">
          <pose>0 1 .001 0 0 0</pose>
          <geometry>
            <box>
              <size>.012 2 .002</size>
            </box>
          </geometry>
          <material>
            <ambient>.16 .65 .3 1</ambient>
            <diffuse>.16 .65 .3 1</diffuse>
          </material>
        </visual>
        <visual name="start">
          <pose>-1.6 0 .003 0 0 0</pose>
          <geometry>
