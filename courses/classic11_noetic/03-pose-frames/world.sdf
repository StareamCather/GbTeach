<?xml version="1.0"?>
<sdf version="1.7">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.82 0.87 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="surface">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.68 0.72 1</ambient>
            <diffuse>0.65 0.68 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 命名frame只定义参考系；attached_to不创建机械关节，relative_to只解释初始pose。 -->
    <frame name="mount_frame" attached_to="rig">
      <pose relative_to="rig">0 0 0.6 0 0 0</pose>
    </frame>
    <!-- 蓝色安装架：世界位置(2,1,0.2)，yaw=pi/2；所有角度均用弧度。 -->
    <model name="rig">
      <static>true</static>
      <pose>2 1 0.2 0 0 1.5707963267948966</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="base">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.6 .6 .4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.8 1</ambient>
            <diffuse>0.2 0.6 0.8 1</diffuse>
          </material>
        </visual>
        <visual name="axis_x">
          <pose>0.325 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.65 .025 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.08 0.08 1</ambient>
            <diffuse>1 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="axis_y">
          <pose>0 0.325 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 0.65 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="axis_z">
          <pose>0 0 0.325 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 .025 0.65</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.25 1 1</ambient>
            <diffuse>0.1 0.25 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 世界坐标轴：红+x、绿+y、蓝+z。仅使用本地box几何。 -->
    <model name="world_axes">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="origin">
        <visual name="axis_x">
          <pose>0.4 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 .025 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.08 0.08 1</ambient>
            <diffuse>1 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="axis_y">
          <pose>0 0.4 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 0.8 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="axis_z">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 .025 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.25 1 1</ambient>
            <diffuse>0.1 0.25 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 命名frame的可视化轴是独立静态模型，表示加载时的参考位姿，不是动态TF发布器。 -->
    <model name="mount_axes">
      <static>true</static>
      <pose relative_to="mount_frame">0 0 0 0 0 0</pose>
      <link name="origin">
        <visual name="axis_x">
          <pose>0.225 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.45 .025 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.08 0.08 1</ambient>
            <diffuse>1 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="axis_y">
          <pose>0 0.225 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 0.45 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="axis_z">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 .025 0.45</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.25 1 1</ambient>
            <diffuse>0.1 0.25 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- sensor_marker只是安装位姿标记，不包含sensor元素，不产生传感器数据。 -->
    <model name="sensor_marker">
      <static>true</static>
      <pose relative_to="mount_frame">1 0 0 0 0 0</pose>
      <link name="origin">
        <pose>0 0 0 0 0 0</pose>
        <visual name="axis_x">
          <pose>0.15 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.3 .025 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.08 0.08 1</ambient>
            <diffuse>1 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="axis_y">
          <pose>0 0.15 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 0.3 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="axis_z">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 .025 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.25 1 1</ambient>
            <diffuse>0.1 0.25 1 1</diffuse>
          </material>
        </visual>
        <visual name="model_origin">
          <geometry>
            <sphere>
              <radius>.035</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="body">
        <pose>0.15 0 0.05 0 0 0.25</pose>
        <visual name="marker_body">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.2 .12 .1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.25 0.12 1</ambient>
            <diffuse>0.95 0.25 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="axis_x">
          <pose>0.1 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 .025 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.08 0.08 1</ambient>
            <diffuse>1 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="axis_y">
          <pose>0 0.1 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 0.2 .025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="axis_z">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>.025 .025 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.25 1 1</ambient>
            <diffuse>0.1 0.25 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <gui>
      <camera name="user_camera">
        <pose>7 -8 6 0 0.45 2.3</pose>
      </camera>
    </gui>
  </world>
</sdf>
