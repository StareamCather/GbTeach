{
  "id": "47",
  "title": "MLP 模仿学习：把真实专家轨迹变成控制器",
  "module": "附加专项·学习控制与飞行",
  "order": 47,
  "profile": "classic11-noetic",
  "requires_ros": false,
  "requires_tools": [
    "g++",
    "pkg-config"
  ],
  "requires_pkg_config": {
    "gazebo": "11.15.1"
  },
  "requires_native_server": true,
  "graceful_server_shutdown": true,
  "requires_python_modules": [
    "numpy"
  ],
  "world": "world.sdf",
  "prepare": [
    "python3 prepare.py"
  ],
  "prepare_timeout": 90,
  "verify": "verify.py",
  "verify_timeout": 150,
  "after_startup": [
    "python3 lab.py ready"
  ],
  "reference": "reference.md",
  "objectives": [
    "追踪真实物理状态、动作与反馈的信息流",
    "实现少量关键神经网络代码并检查训练与测试边界",
    "用严格 20 步物理转移与未见绝对目标验证学习控制结果"
  ],
  "commands": [
    {
      "title": "完整参考实验（不计作业完成）",
      "command": "python3 lab.py demo"
    },
    {
      "title": "编辑关键代码",
      "command": "gedit --new-window learner.py"
    },
    {
      "title": "检查个人代数实现",
      "command": "python3 lab.py student-check"
    },
    {
      "title": "执行个人实现与真实物理验收",
      "command": "python3 lab.py student"
    }
  ]
}
