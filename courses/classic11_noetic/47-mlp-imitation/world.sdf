<?xml version="1.0"?><sdf version="1.7"><world name="default">
<gravity>0 0 -9.81</gravity><physics name="ode" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate><ode><solver><iters>80</iters></solver></ode></physics>
<scene><ambient>.55 .55 .55 1</ambient><background>.86 .9 .95 1</background></scene>
<light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>.9 .9 .9 1</diffuse><direction>-.4 .2 -1</direction></light>
<gui><camera name="user_camera"><pose>2 -4 2.2 0 .32 2.05</pose></camera></gui>
<model name="track"><static>true</static><pose>0 0 .1 0 0 0</pose><link name="rail">
<visual name="beam"><geometry><box><size>2.6 .1 .1</size></box></geometry><material><ambient>.25 .28 .32 1</ambient><diffuse>.25 .28 .32 1</diffuse></material></visual>
<visual name="zero_reference"><pose>0 -.22 .01 0 0 0</pose><geometry><box><size>.025 .4 .08</size></box></geometry><material><ambient>.1 .8 .25 1</ambient><diffuse>.1 .8 .25 1</diffuse></material></visual></link></model>
<model name="learning_cart"><allow_auto_disable>false</allow_auto_disable><link name="cart"><pose>0 0 .35 0 0 0</pose><gravity>false</gravity><inertial><mass>1</mass><inertia><ixx>.01</ixx><iyy>.01</iyy><izz>.01</izz></inertia></inertial><collision name="cart_collision"><geometry><box><size>.3 .25 .2</size></box></geometry></collision><visual name="cart_visual"><geometry><box><size>.3 .25 .2</size></box></geometry><material><ambient>.1 .4 .85 1</ambient><diffuse>.1 .4 .85 1</diffuse></material></visual></link>
<joint name="slide" type="prismatic"><parent>world</parent><child>cart</child><pose relative_to="cart">0 0 0 0 0 0</pose><axis><xyz expressed_in="__model__">1 0 0</xyz><limit><lower>-1.2</lower><upper>1.2</upper><effort>8</effort><velocity>6</velocity></limit><dynamics><damping>.4</damping></dynamics></axis></joint><plugin name="learning_plant" filename="libgazeboteach_learning.so"/></model>
</world></sdf>
